# Plant's variable names, without values. Locally:
#   vercel env pull apps/web/.env.local   -> development keys (AI)
#   pnpm env:local                        -> local Supabase (apps/web/.env.development.local)
# If you add a variable, add it here and on every platform (Vercel, GitHub Environments).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inngest (not needed locally: `next dev` uses the Dev Server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AI
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Traces (Dash0 from PLA-73: its endpoint, and its Authorization token and
# Dash0-Dataset as headers). Unset on every platform until then: either
# endpoint turns export on, and without one nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Local Supabase CLI only (shell or supabase/.env); staging and production use the
# Supabase dashboard, nothing goes to Vercel or GitHub.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
