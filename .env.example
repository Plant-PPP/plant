# Nombres de las variables de Plant, sin valores. En local:
#   vercel env pull apps/web/.env.local   -> keys de desarrollo (IA)
#   pnpm env:local                        -> Supabase local (apps/web/.env.development.local)
# Si sumás una variable, agregala acá y en cada plataforma (Vercel, GitHub Environments).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inngest (en local no hacen falta: `next dev` usa el Dev Server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# IA
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
